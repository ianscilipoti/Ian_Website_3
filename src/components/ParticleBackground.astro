---
// Spring particle background — circles that repel from the mouse and spring back
---

<canvas id="particle-canvas"></canvas>

<script>
  // ── Change this to set the particle color ──
  const PARTICLE_COLOR = '#def8ff';
  // ───────────────────────────────────────────

  const CANVAS_SIZE    = 128; // internal buffer — scale this up to zoom in/out
  const PARTICLE_COUNT = 200;
  const CLUSTER_COUNT  = 15;
  const CLUSTER_SPREAD = 0.5;
  const RADIUS_MIN     = 2;
  const RADIUS_MAX     = 6;
  const STIFFNESS      = 0.35;
  const DAMPING        = 0.93;
  const MOUSE_RADIUS   = 27;
  const REPEL_FORCE    = 0.5;

  interface Particle {
    x: number; y: number;
    vx: number; vy: number;
    rx: number; ry: number;
    r: number;
  }

  let particles: Particle[] = [];
  let mouseX = -9999;
  let mouseY = -9999;

  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  canvas.width  = CANVAS_SIZE;
  canvas.height = CANVAS_SIZE;
  const ctx = canvas.getContext('2d')!;

  function createParticles() {
    particles = [];
    const centers = Array.from({ length: CLUSTER_COUNT }, () => ({
      cx: 0.05 + Math.random() * 0.9,
      cy: 0.05 + Math.random() * 0.9,
    }));
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const { cx, cy } = centers[i % CLUSTER_COUNT];
      const angle = Math.random() * Math.PI * 2;
      const dist  = Math.random() * CLUSTER_SPREAD;
      const rx = Math.max(0.01, Math.min(0.99, cx + Math.cos(angle) * dist));
      const ry = Math.max(0.01, Math.min(0.99, cy + Math.sin(angle) * dist));
      particles.push({
        x: rx * CANVAS_SIZE, y: ry * CANVAS_SIZE,
        vx: 0, vy: 0,
        rx, ry,
        r: RADIUS_MIN + Math.random() * (RADIUS_MAX - RADIUS_MIN),
      });
    }
  }

function update() {
    for (const p of particles) {
      p.vx += (p.rx * CANVAS_SIZE - p.x) * STIFFNESS;
      p.vy += (p.ry * CANVAS_SIZE - p.y) * STIFFNESS;

      const dx   = p.x - mouseX;
      const dy   = p.y - mouseY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < MOUSE_RADIUS && dist > 0) {
        const strength = (1 - dist / MOUSE_RADIUS) * REPEL_FORCE;
        p.vx += (dx / dist) * strength;
        p.vy += (dy / dist) * strength;
      }

      p.vx *= DAMPING;
      p.vy *= DAMPING;
      p.x  += p.vx;
      p.y  += p.vy;
    }
  }

  function draw() {
    ctx.clearRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);
    ctx.fillStyle = PARTICLE_COLOR;
    ctx.globalAlpha = 0.65;
    for (const p of particles) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  const FRAME_MS = 1000 / 30;
  let lastFrame = 0;

  function loop(ts: number) {
    if (ts - lastFrame >= FRAME_MS) {
      update();
      draw();
      lastFrame = ts;
    }
    requestAnimationFrame(loop);
  }

  createParticles();
  requestAnimationFrame(loop as FrameRequestCallback);

  if (!window.matchMedia('(pointer: coarse)').matches) {
    window.addEventListener('mousemove', (e) => {
      const r = canvas.getBoundingClientRect();
      const scale = r.width / CANVAS_SIZE;
      mouseX = (e.clientX - r.left) / scale;
      mouseY = (e.clientY - r.top)  / scale;
    });
  }
</script>

<style>
  canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vmax;
    height: 100vmax;
    z-index: 0;
    pointer-events: none;
    image-rendering: pixelated;
    filter: blur(5px);
    mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
  }
</style>
